# Copy this file to server/.env (never commit .env) and fill in real values.
# Placeholders only in this file.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string for the APPLICATION database. Copy it from Atlas into server/.env
# ONLY, replace the <placeholders>, and keep the database name in the path.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/hostel_expense_tracker?retryWrites=true&w=majority

# Optional, only for `npm run test:atlas`: a SEPARATE test database on the same cluster.
# Its database name must end with "_test" and differ from the one above.
MONGODB_TEST_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/hostel_expense_tracker_test?retryWrites=true&w=majority

# Secret that signs login tokens. At least 32 random characters; keep it private.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Browser origin allowed to call the API in development (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Front end only (client/.env, optional): API base URL. Leave unset to use same-origin /api (dev proxy or
# single-origin production). Only non-secret values belong in VITE_* variables; they are public in the bundle.
# VITE_API_URL=http://localhost:5000

# --- Continue with Google (optional; the button is hidden when this is empty) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application).
# This is the public Client ID only. The client secret is NOT used and must never be added.
GOOGLE_CLIENT_ID=

# --- Emails (password reset, email-change confirmation). Optional; choose ONE provider ---
# Without a provider, links are only printed to the server console when NODE_ENV is not production,
# and in production the request fails (nothing is claimed as sent).
# Option A: any SMTP server. Render's free web services block SMTP ports, so use option B there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Option B: Brevo HTTPS API (works on Render free). MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
MAIL_FROM=Hostel Expense Tracker <verified-sender@example.com>
# Public base URL of the site, used in emailed links. Defaults to Render's own URL when deployed there.
APP_URL=http://localhost:5173

# Optional: login/register/etc. attempts allowed per IP per 15 minutes (default 10)
# AUTH_RATE_LIMIT=10
